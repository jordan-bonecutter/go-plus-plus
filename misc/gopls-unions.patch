+// unionConstructors completes the static constructors carried in the union's
+// private export metadata. Constructors are functions, not receiver methods.
+func (c *completer) unionConstructors(typ types.Type) {
+	st, ok := typ.Underlying().(*types.Struct)
+	if !ok || st.NumFields() != 3 || st.Field(0).Name() != "union·data" || st.Field(1).Name() != "union·anchor" || st.Field(2).Name() != "union·tag" {
+		return
+	}
+	data, ok := st.Field(0).Type().Underlying().(*types.Struct)
+	if !ok {
+		return
+	}
+	for field := range data.Fields() {
+		name, ok := strings.CutPrefix(field.Name(), "union·variant·")
+		if !ok || (field.Pkg() != c.pkg.Types() && !token.IsExported(name)) {
+			continue
+		}
+		marker, ok := field.Type().(*types.Array)
+		if !ok {
+			continue
+		}
+		param := types.NewParam(field.Pos(), field.Pkg(), "value", marker.Elem())
+		result := types.NewVar(field.Pos(), field.Pkg(), "", typ)
+		sig := types.NewSignatureType(nil, nil, nil, types.NewTuple(param), types.NewTuple(result), false)
+		fn := types.NewFunc(field.Pos(), field.Pkg(), name, sig)
+		c.deepState.enqueue(candidate{obj: fn, score: stdScore})
+	}
 }
 
