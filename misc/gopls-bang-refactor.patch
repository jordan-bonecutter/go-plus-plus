+// hasBangReturn detects propagation whose enclosing function would change if
+// the selected code moved. A whole nested function literal retains its scope.
+func hasBangReturn(root ast.Node, start, end token.Pos) bool {
+	found := false
+	ast.Inspect(root, func(n ast.Node) bool {
+		if n == nil || found || n.End() < start || n.Pos() > end {
+			return false
+		}
+		if lit, ok := n.(*ast.FuncLit); ok && start <= lit.Pos() && lit.End() <= end {
+			return false
+		}
+		if call, ok := n.(*ast.CallExpr); ok && call.Bang.IsValid() && start <= call.Pos() && call.End() <= end {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
