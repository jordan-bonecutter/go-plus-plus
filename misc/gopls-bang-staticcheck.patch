+// bang evaluates a postfix ! call once and emits its implicit error return.
+// A multi-valued expression retains the full call tuple internally; consumers
+// expand only the prefix described by the type-checked source expression.
+func (b *builder) bang(fn *Function, e *ast.CallExpr) Value {
+	var call Call
+	b.setCall(fn, e, &call.Call)
+	results := call.Call.Signature().Results()
+	if results.Len() == 1 {
+		call.setType(results.At(0).Type())
+	} else {
+		call.setType(results)
+	}
+	value := emitCall(fn, &call, e)
+	err := value
+	if results.Len() > 1 {
+		err = emitExtract(fn, value, results.Len()-1, e)
+	}
+	failed := fn.newBasicBlock("bang.error")
+	success := fn.newBasicBlock("bang.success")
+	emitIf(fn, emitCompare(fn, token.NEQ, err, zeroConst(err.Type(), e), e), failed, success, e)
+	fn.currentBlock = failed
+	sig := fn.source.Signature
+	for i := 0; i < sig.Results().Len(); i++ {
+		result := sig.Results().At(i)
+		var value Value
+		if i == sig.Results().Len()-1 {
+			value = err
+		} else if result.Name() == "" || result.Name() == "_" {
+			value = zeroConst(fn.typ(result.Type()), e)
+		} else {
+			continue
+		}
+		var addr Value
+		if fn == fn.source {
+			addr = fn.results[i]
+		} else {
+			addr = fn.lookup(fn.returnVars[i], false)
+		}
+		emitStore(fn, addr, value, e)
+	}
+	b.returnStmt(fn, &ast.ReturnStmt{Return: e.Bang})
+	fn.currentBlock = success
+	if results.Len() == 2 {
+		return emitExtract(fn, value, 0, e)
+	}
+	return value
+}
