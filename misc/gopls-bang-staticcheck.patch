+// isAnalysisUnion recognizes the private metadata shared by local and imported
+// tagged unions. Analysis deliberately keeps payload construction opaque rather
+// than confusing the runtime's overlapping storage with ordinary Go fields.
+func isAnalysisUnion(t types.Type) bool {
+	st, ok := t.Underlying().(*types.Struct)
+	return ok && st.NumFields() == 3 && st.Field(0).Name() == "union·data" && st.Field(1).Name() == "union·anchor" && st.Field(2).Name() == "union·tag"
+}
+
+func (b *builder) unionConstructor(fn *Function, e *ast.SelectorExpr) Value {
+	if fn.info.Selections[e] != nil || !fn.info.Types[e.X].IsType() || !isAnalysisUnion(fn.typeOf(e.X)) {
+		return nil
+	}
+	if _, ok := fn.info.Uses[e.Sel].(*types.Func); !ok {
+		return nil
+	}
+	sig := fn.typ(fn.typeOf(e)).(*types.Signature)
+	return fn.Prog.NewFunction("union."+e.Sel.Name, sig, "opaque tagged union constructor")
+}
