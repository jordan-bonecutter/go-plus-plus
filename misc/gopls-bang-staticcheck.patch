+// unionSwitch emits conservative variant tests with correctly typed bindings.
+// Separate tests are essential: two variants may have the same payload type.
+func (b *builder) unionSwitch(fn *Function, s *ast.TypeSwitchStmt, label *lblock) bool {
+	var guard *ast.TypeAssertExpr
+	switch ass := s.Assign.(type) {
+	case *ast.ExprStmt:
+		guard, _ = ast.Unparen(ass.X).(*ast.TypeAssertExpr)
+	case *ast.AssignStmt:
+		guard, _ = ast.Unparen(ass.Rhs[0]).(*ast.TypeAssertExpr)
+	}
+	if guard == nil || !isAnalysisUnion(fn.typeOf(guard.X)) {
+		return false
+	}
+	name, ok := guard.Type.(*ast.Ident)
+	if !ok || name.Name != "variant" {
+		return false
+	}
+	if s.Init != nil {
+		b.stmt(fn, s.Init)
+	}
+	x := b.expr(fn, guard.X)
+	done := fn.newBasicBlock("variant.done")
+	if label != nil {
+		label._break = done
+	}
+	var fallback *ast.CaseClause
+	body := func(cc *ast.CaseClause, value Value) {
+		if obj, ok := fn.info.Implicits[cc].(*types.Var); ok {
+			emitStore(fn, emitLocalVar(fn, obj, cc), value, cc)
+		}
+		fn.targets = &targets{tail: fn.targets, _break: done}
+		b.stmtList(fn, cc.Body)
+		fn.targets = fn.targets.tail
+		emitJump(fn, done, cc)
+	}
+	for _, clause := range s.Body.List {
+		cc := clause.(*ast.CaseClause)
+		if cc.List == nil {
+			fallback = cc
+			continue
+		}
+		payload := fn.typ(fn.typeOf(cc.List[0]))
+		result := types.NewTuple(types.NewVar(token.NoPos, nil, "value", payload), types.NewVar(token.NoPos, nil, "ok", tBool))
+		param := types.NewTuple(types.NewParam(token.NoPos, nil, "union", x.Type()))
+		sig := types.NewSignatureType(nil, nil, nil, param, result, false)
+		test := fn.Prog.NewFunction("union.match."+cc.List[0].(*ast.Ident).Name, sig, "opaque tagged union match")
+		var call Call
+		call.Call.Value = test
+		call.Call.Args = []Value{x}
+		call.setType(result)
+		tuple := emitCall(fn, &call, cc)
+		matched, next := fn.newBasicBlock("variant.body"), fn.newBasicBlock("variant.next")
+		emitIf(fn, emitExtract(fn, tuple, 1, cc), matched, next, cc)
+		fn.currentBlock = matched
+		body(cc, emitExtract(fn, tuple, 0, cc))
+		fn.currentBlock = next
+	}
+	if fallback != nil {
+		body(fallback, x)
+	} else {
+		fn.emit(&Panic{X: emitConv(fn, stringConst("union has no active variant", s), tEface, s)}, s)
+	}
+	fn.currentBlock = done
+	return true
+}
